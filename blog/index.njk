<title>Blog — Ghiduri piatră naturală | StoneLine</title>
<meta name="description" content="Ghiduri practice, comparații și sfaturi tehnice despre marmură, granit, travertin, andezit și ardezie — de la echipa StoneLine Cristești.">
<link rel="canonical" href="https://stone-line.ro/blog/">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Work+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
:root{--ink:#1c1d1e;--base:#2c2e30;--slate:#5c6167;--paper:#f3f1ec;--paper-2:#e9e5dc;--stone:#b7a58a;--stone-dim:#8c7c64;--line:rgba(28,29,30,.12);--line-on-dark:rgba(243,241,236,.16);--serif:'Playfair Display',serif;--sans:'Work Sans',sans-serif;--mono:'IBM Plex Mono',monospace;--ease:cubic-bezier(.4,0,.2,1);}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--base);font-family:var(--sans);-webkit-font-smoothing:antialiased;}
img{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
ul{list-style:none;}
:focus-visible{outline:2px solid var(--stone-dim);outline-offset:3px;}
.wrap{max-width:1240px;margin:0 auto;padding:0 40px;}
@media(max-width:720px){.wrap{padding:0 22px;}}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--stone-dim);display:flex;align-items:center;gap:10px;margin-bottom:18px;}
.eyebrow::before{content:'';width:22px;height:1px;background:var(--stone-dim);display:inline-block;}
h1,h2,h3{font-family:var(--serif);font-weight:600;letter-spacing:-.01em;color:var(--ink);}
.btn{display:inline-flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;padding:15px 26px;border:1px solid var(--ink);background:var(--ink);color:var(--paper);transition:background .3s var(--ease),color .3s var(--ease),border-color .3s var(--ease);white-space:nowrap;}
.btn:hover{background:var(--stone-dim);border-color:var(--stone-dim);}

/* Nav */
header.site{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(243,241,236,.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
.nav{display:flex;align-items:center;justify-content:space-between;padding:20px 40px;max-width:1240px;margin:0 auto;}
@media(max-width:720px){.nav{padding:16px 22px;}}
.logo{font-family:var(--serif);font-size:20px;font-weight:700;letter-spacing:.02em;}
.logo span{color:var(--stone-dim);}
.nav-links{display:flex;align-items:center;gap:28px;}
.nav-links a{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);transition:color .2s var(--ease);}
.nav-links a:hover,.nav-links a.active{color:var(--ink);}
.nav-cta{display:flex;align-items:center;}
.nav-toggle{display:none;background:none;border:none;cursor:pointer;padding:8px;flex-direction:column;gap:5px;z-index:210;position:relative;}
.nav-toggle span{display:block;width:22px;height:2px;background:var(--ink);transition:transform .25s var(--ease),opacity .25s var(--ease);}
.nav-overlay{display:none;position:fixed;inset:0;background:rgba(28,29,30,.45);z-index:150;}
@media(max-width:900px){
  .nav-toggle{display:flex;}
  .nav-links{display:flex !important;flex-direction:column;align-items:flex-start;gap:0;position:fixed;top:0;right:0;height:100vh;width:min(78vw,320px);background:var(--paper);border-left:1px solid var(--line);padding:96px 28px 28px;transform:translateX(100%);transition:transform .35s var(--ease);z-index:200;overflow-y:auto;}
  .nav-links.open{transform:translateX(0);}
  .nav-links a{padding:16px 0;width:100%;border-bottom:1px solid var(--line);font-size:13px;}
  .nav-overlay.open{display:block;}
  .nav-toggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .nav-toggle.open span:nth-child(2){opacity:0;}
  .nav-toggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
  .nav-cta .btn{padding:12px 18px;font-size:11px;}
}

/* Blog index */
.blog-hero{padding:148px 0 72px;border-bottom:1px solid var(--line);}
.blog-hero h1{font-size:clamp(34px,4.5vw,60px);line-height:1.08;max-width:18ch;margin-bottom:18px;}
.blog-hero p{font-size:16px;color:var(--slate);max-width:46ch;}

/* Category filter */
.blog-filters{display:flex;gap:10px;padding:28px 0;border-bottom:1px solid var(--line);flex-wrap:wrap;}
.cat-btn{font-family:var(--mono);font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;padding:9px 16px;border:1px solid var(--line);background:transparent;color:var(--slate);cursor:pointer;transition:all .2s var(--ease);}
.cat-btn.active,.cat-btn:hover{border-color:var(--ink);color:var(--ink);}

/* Post grid */
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:var(--line);margin:2px 0;}
@media(max-width:900px){.blog-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:600px){.blog-grid{grid-template-columns:1fr;}}
.post-card{background:var(--paper);padding:36px 32px;display:flex;flex-direction:column;gap:14px;transition:background .2s var(--ease);}
.post-card:hover{background:var(--paper-2);}
.post-card-cat{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--stone-dim);}
.post-card-title{font-family:var(--serif);font-size:20px;line-height:1.3;color:var(--ink);font-weight:600;}
.post-card-desc{font-size:14px;color:var(--slate);line-height:1.6;flex:1;}
.post-card-meta{font-family:var(--mono);font-size:11px;color:var(--stone-dim);display:flex;gap:12px;align-items:center;margin-top:8px;padding-top:14px;border-top:1px solid var(--line);}
.post-card-meta .dot{width:3px;height:3px;border-radius:50%;background:var(--stone-dim);}

/* Empty state */
.blog-empty{padding:80px 0;text-align:center;color:var(--slate);font-family:var(--mono);font-size:14px;}

/* Footer */
footer{background:var(--ink);color:rgba(243,241,236,.55);padding:50px 0;}
.footer-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;}
.footer-row .logo{color:var(--paper);}
.footer-row .logo span{color:var(--stone);}
.footer-links{display:flex;gap:24px;font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;text-transform:uppercase;}
.footer-links a:hover{color:var(--paper);}
.copyright{font-family:var(--mono);font-size:11px;margin-top:26px;color:rgba(243,241,236,.35);}
.legal-row{display:flex;gap:18px;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid rgba(243,241,236,.12);font-family:var(--mono);font-size:10.5px;}
.legal-row a{color:rgba(243,241,236,.5);}
.legal-row a:hover{color:var(--paper);}
@media(prefers-reduced-motion:reduce){*{transition:none !important;}}
</style>
</head>
<body>

<header class="site">
  <nav class="nav">
    <a href="/" class="logo">STONE<span>LINE</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <div class="nav-links">
      <a href="/#materiale">Materiale</a>
      <a href="/#servicii">Servicii</a>
      <a href="/#portofoliu">Portofoliu</a>
      <a href="/#showroom">Showroom</a>
      <a href="/#contact">Contact</a>
      <a href="/blog/" class="active">Blog</a>
    </div>
    <div class="nav-cta">
      <a class="btn" href="https://wa.me/40365402379" target="_blank" rel="noopener">Scrie pe WhatsApp</a>
    </div>
  </nav>
</header>

<div class="nav-overlay" id="navOverlay"></div>

<main>
  <section class="blog-hero">
    <div class="wrap">
      <div class="eyebrow">Resurse StoneLine</div>
      <h1>Ghiduri practice despre piatră naturală</h1>
      <p>Date tehnice, comparații de materiale și sfaturi de la echipa cu 20+ ani experiență — ca să decizi în cunoștință de cauză.</p>
    </div>
  </section>

  <div class="wrap">
    <div class="blog-filters" id="blogFilters">
      <button class="cat-btn active" data-cat="all">Toate</button>
      <button class="cat-btn" data-cat="Materiale">Materiale</button>
      <button class="cat-btn" data-cat="Aplicații">Aplicații</button>
      <button class="cat-btn" data-cat="Ghiduri tehnice">Ghiduri tehnice</button>
      <button class="cat-btn" data-cat="Servicii">Servicii</button>
      <button class="cat-btn" data-cat="Prețuri și costuri">Prețuri</button>
    </div>
  </div>

  <div class="wrap" style="padding-bottom:100px;">
    {% set posts = collections.posts | reverse %}
    {% if posts.length %}
    <div class="blog-grid" id="postGrid">
      {% for post in posts %}
      <a href="{{ post.url }}" class="post-card" data-cat="{{ post.data.category }}">
        <div class="post-card-cat">{{ post.data.category }}</div>
        <div class="post-card-title">{{ post.data.title }}</div>
        <div class="post-card-desc">{{ post.data.description }}</div>
        <div class="post-card-meta">
          <time datetime="{{ post.date | dateISO }}">{{ post.date | dateRO }}</time>
          <span class="dot"></span>
          <span>{{ post.templateContent | readingTime }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="blog-empty">Primul articol apare în curând.</div>
    {% endif %}
  </div>
</main>

<footer>
  <div class="wrap">
    <div class="footer-row">
      <a href="/" class="logo">STONE<span>LINE</span></a>
      <div class="footer-links">
        <a href="/#materiale">Materiale</a>
        <a href="/#portofoliu">Portofoliu</a>
        <a href="/#showroom">Showroom</a>
        <a href="/contact.html">Contact</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
    <div class="legal-row">
      <a href="https://www.anpc.ro/" target="_blank" rel="noopener">ANPC</a>
      <a href="https://reclamatiisal.anpc.ro/" target="_blank" rel="noopener">SAL</a>
      <a href="/confidentialitate.html">Politica de confidențialitate</a>
      <a href="/cookie-uri.html">Cookie-uri</a>
      <a href="/gdpr.html">GDPR</a>
    </div>
    <div class="copyright">© 2026 Showroom StoneLine — Cristești, Mureș. Toate drepturile rezervate.</div>
  </div>
</footer>

<script>
// Category filter
document.querySelectorAll('.cat-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.cat;
    document.querySelectorAll('.post-card').forEach(card => {
      card.style.display = (cat === 'all' || card.dataset.cat === cat) ? '' : 'none';
    });
  });
});
// Mobile nav
(function(){
  var t=document.getElementById('navToggle'),l=document.querySelector('.nav-links'),o=document.getElementById('navOverlay');
  if(!t||!l||!o)return;
  var op=l.parentNode,os=l.nextSibling,mq=window.matchMedia('(max-width:900px)');
  function close(){t.classList.remove('open');l.classList.remove('open');o.classList.remove('open');t.setAttribute('aria-expanded','false');}
  function place(m){if(m){if(l.parentNode!==document.body){document.body.appendChild(o);document.body.appendChild(l);}}else{close();if(l.parentNode!==op)op.insertBefore(l,os);}}
  t.addEventListener('click',function(){var i=l.classList.toggle('open');t.classList.toggle('open',i);o.classList.toggle('open',i);t.setAttribute('aria-expanded',i);});
  o.addEventListener('click',close);
  l.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
  place(mq.matches);
  (mq.addEventListener||mq.addListener).call(mq,mq.addEventListener?'change':function(e){place(e.matches);},(e)=>place(e.matches));
})();
</script>
</body>
</html>
